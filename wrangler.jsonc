// Cloudflare Workers 배포 설정
// - dist 폴더(npm run build 결과)를 정적 파일로 올린다
// - /api/* 만 worker/index.ts 가 받는다: 로그인·공부 자료 동기화 (Durable Object + SQLite, 무료 플랜 가능)
{
  "name": "life",
  "compatibility_date": "2026-09-26",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "Accounts" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Accounts"] }]
}
