// Cloudflare Workers 배포 설정
// - dist 폴더(npm run build 결과)를 정적 파일로 올린다
// - /api/* 만 worker/index.ts 가 받는다: 로그인·공부 자료 동기화 (Durable Object + SQLite, 무료 플랜 가능)
{
  "name": "life",
  "compatibility_date": "2026-09-26",
  "main": "worker/index.ts",
  // 배포할 때 life.<계정>.workers.dev 주소를 켠다
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 번역 (worker/translate.ts): Workers AI
  "ai": { "binding": "AI" },
  // 로그 저장 (대시보드 Observability 에서 지난 오류도 볼 수 있게)
  "observability": { "enabled": true },
  // 문제 사진 저장 (worker/r2guard.ts 가 무료 한도 90% 에서 막는다)
  "r2_buckets": [{ "binding": "PROBLEMS", "bucket_name": "life" }],
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "Accounts" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Accounts"] }]
}
